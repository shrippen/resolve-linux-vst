#!/usr/bin/env bash
# resolve-vst: DaVinci Resolve mit VST-Lader starten.
#
#   resolve-vst [Resolve-Argumente]   Links auffrischen, Resolve starten
#   resolve-vst link                  nur die Links auffrischen
#   resolve-vst list                  gefundene Plugins anzeigen (VST3 mit Klassen)
#   resolve-vst restore               geänderte Wine-DPI zurücksetzen (geschieht sonst
#                                     automatisch, wenn Resolve endet)
#   resolve-vst categories            Kategorien neuer Plugins in Resolves Liste eintragen
#                                     (geschieht sonst bei jedem Start)
#
# Resolves Scanner nimmt nur Einträge mit der Endung .vst (macOS-Stil). Darum legt das
# Skript für jede VST2-Bibliothek einen Symlink Name.vst in $RESOLVE_VST_LINKS an; diesen
# Ordner einmal in Resolve unter Einstellungen → Audio-Plugins als VST-Pfad eintragen.
# VST3-Plugins erscheinen dort als Ordner VST3/…/Klasse.vst mit den Dateien bundle (Symlink
# auf das Bundle) und class (Klassen-ID); libresolve-vst.so lädt sie über den VST3-Adapter.
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
lib=${RESOLVE_VST_LIB:-}
classes=""
for dir in "$here/build" "$here/../lib/resolve-vst"; do
    [[ -z $lib && -f $dir/libresolve-vst.so ]] && lib=$(readlink -f "$dir/libresolve-vst.so")
    [[ -z $classes && -x $dir/vst3-classes ]] && classes=$(readlink -f "$dir/vst3-classes")
done
resolve=${RESOLVE_BIN:-/opt/resolve/bin/resolve}
links=${RESOLVE_VST_LINKS:-${XDG_DATA_HOME:-$HOME/.local/share}/resolve-vst/vst}
# Vorwerte der Wine-DPI, geschrieben von libresolve-vst.so (stateDir() dort).
restore=${XDG_STATE_HOME:-$HOME/.local/state}/resolve-vst/wine-dpi-restore
# Klassen je VST3-Bundle (Auslesen startet bei yabridge Wine, darum zwischengespeichert).
cache=${XDG_CACHE_HOME:-$HOME/.cache}/resolve-vst/vst3
# Einträge, die Resolve nicht sehen soll (siehe entries).
ignore=${XDG_CONFIG_HOME:-$HOME/.config}/resolve-vst/ignore

# Suchpfade für VST2 unter Linux, wie bei anderen Hosts üblich; $VST_PATH hat Vorrang.
if [[ -n ${VST_PATH:-} ]]; then
    IFS=: read -ra roots <<<"$VST_PATH"
else
    roots=("$HOME/.vst" "$HOME/.lxvst" /usr/local/lib/vst /usr/local/lib/lxvst /usr/lib/vst /usr/lib/lxvst)
fi
if [[ -n ${VST3_PATH:-} ]]; then
    IFS=: read -ra roots3 <<<"$VST3_PATH"
else
    roots3=("$HOME/.vst3" /usr/local/lib/vst3 /usr/lib/vst3)
fi

is_vst2() {
    nm -D --defined-only "$1" 2>/dev/null | grep -qE ' T (VSTPluginMain|main)$'
}

plugins() {
    local root file
    for root in "${roots[@]}"; do
        [[ -d $root ]] || continue
        while IFS= read -r -d '' file; do
            is_vst2 "$file" && printf '%s\t%s\n' "$root" "$file"
        done < <(find -L "$root" -type f -name '*.so' -print0 2>/dev/null)
    done
}

# VST3-Bundles (Ordner oder alte Einzeldateien Name.vst3), je Zeile Wurzel<Tab>Pfad.
bundles() {
    local root file
    for root in "${roots3[@]}"; do
        [[ -d $root ]] || continue
        find -L "$root" -mindepth 1 -name '*.vst3' -prune -printf "$root\t%p\n" 2>/dev/null
    done
}

# Klassen eines Bundles (ID<Tab>Name<Tab>Unterkategorien), aus dem Zwischenspeicher, solange
# sich die Bibliotheken im Bundle nicht geändert haben.
classes_of() {
    local bundle=$1 key file
    key="$(readlink -f "$bundle") $(find -L "$bundle" -maxdepth 3 -name '*.so' -printf '%T@ %s ' 2>/dev/null)"
    file="$cache/$(sha1sum <<<"$bundle" | cut -c1-16)"
    if [[ -f $file && $(head -n1 "$file") == "$key" ]]; then
        tail -n +2 "$file"
        return
    fi
    mkdir -p "$cache"
    local out
    out=$(timeout 120 "$classes" "$bundle" 2>/dev/null) || true
    printf '%s\n%s' "$key" "${out:+$out$'\n'}" >"$file"
    printf '%s' "${out:+$out$'\n'}"
}

# Einträge im Link-Ordner, je Zeile Pfad<Tab>Quelle<Tab>Klassen-ID<Tab>VST3-Kategorien (beide
# leer bei VST2), ohne die
# Muster aus $ignore (Shell-Muster auf den Pfad, eins je Zeile, # für Kommentare).
entries() {
    local root file rel id name sub dir target found count
    local -A seen=()
    local -a skip=()
    if [[ -f $ignore ]]; then
        mapfile -t skip < <(sed -e 's/[[:space:]]*#.*//' -e '/^[[:space:]]*$/d' "$ignore")
    fi
    emit() { # Pfad Quelle [ID Kategorien]
        local path=$1 pattern
        for pattern in "${skip[@]}"; do
            # shellcheck disable=SC2053 # Muster gewollt
            [[ $path == $pattern ]] && return
        done
        printf '%s\t%s\t%s\t%s\n' "$path" "$2" "${3:-}" "${4:-}"
    }
    while IFS=$'\t' read -r root file; do
        rel=${file#"$root"/}
        # Ordner auf .vst (z. B. carla.vst/) hält der Scanner selbst für ein Plugin.
        rel=$(sed -E 's#\.vst(/|$)#\1#g' <<<"${rel%.so}")
        target="$rel.vst"
        [[ -n ${seen[$target]:-} ]] && target="$rel ($(basename "$root")).vst"
        seen[$target]=1
        emit "$target" "$file"
    done < <(plugins)

    [[ -n $classes ]] || { echo "resolve-vst: vst3-classes nicht gefunden (make?), keine VST3-Plugins" >&2; return; }
    local -a list=()
    mapfile -t list < <(bundles)
    # Erst alle Bundles auslesen, parallel (yabridge braucht je Bundle einige Sekunden).
    for entry in "${list[@]}"; do
        classes_of "${entry#*$'\t'}" >/dev/null &
        (($(jobs -r | wc -l) >= 8)) && wait -n
    done
    wait
    for entry in "${list[@]}"; do
        root=${entry%%$'\t'*} file=${entry#*$'\t'}
        rel=${file#"$root"/}
        rel=${rel%.vst3}
        found=$(classes_of "$file")
        count=$(grep -c . <<<"$found" || true)
        while IFS=$'\t' read -r id name sub; do
            [[ -n $id ]] || continue
            name=${name//\//-}
            # Eine Klasse: neben die anderen Bundles, sonst in einen Ordner je Bundle.
            if ((count == 1)); then dir=$(dirname "VST3/$rel"); else dir="VST3/$rel"; fi
            target="$dir/$name.vst"
            [[ -n ${seen[$target]:-} ]] && target="$dir/$name ($id).vst"
            seen[$target]=1
            emit "$target" "$file" "$id" "$sub"
        done <<<"$found"
    done
}

# Legt den Link-Ordner neu an, wenn sich die Einträge geändert haben (Liste in .entries).
link() {
    local list path source id n2=0 n3=0
    list=$(entries)
    if [[ -f $links/.entries && $(<"$links/.entries") == "$list" ]]; then
        echo "resolve-vst: Plugins unverändert ($(grep -c . <<<"$list" || true) in $links)" >&2
        return
    fi
    rm -rf "$links"
    mkdir -p "$links"
    while IFS=$'\t' read -r path source id _; do
        [[ -n $path ]] || continue
        if [[ -z $id ]]; then
            mkdir -p "$(dirname "$links/$path")"
            ln -s "$source" "$links/$path"
            n2=$((n2 + 1))
        else
            mkdir -p "$links/$path"
            ln -s "$source" "$links/$path/bundle"
            printf '%s\n' "$id" >"$links/$path/class"
            # Resolve scannt neu, wenn sich die Zeit des Eintrags ändert (<FileTime>): die des
            # Bundles, nicht die des Neuanlegens.
            touch -r "$source" "$links/$path"
            n3=$((n3 + 1))
        fi
    done <<<"$list"
    printf '%s\n' "$list" >"$links/.entries"
    echo "resolve-vst: $n2 VST2- und $n3 VST3-Plugins in $links" >&2
}

# Kategorien in Resolve: Resolve sortiert Plugins nach eigenen Kategorien, gespeichert als
# Bitmaske <CategoryMask> je Plugin in FXConfiguration.xml (Bit i = Eintrag i der Tabelle
# unten, wie cCategories in libFairlightPage.so). Unter Linux setzt der Scanner sie nie, alle
# Plugins landen unter „Unsortiert“. Für VST3 rechnet categories() die Maske wie Resolve selbst
# (PluginHost::GetPluginCategoryMask) aus den Unterkategorien (z. B. "Fx|Dynamics"): erst
# Ersetzungen, dann jeder Kategoriename, der im Text vorkommt. Für VST2 aus <Category>.
fx_config=${RESOLVE_FX_CONFIG:-$HOME/.local/share/DaVinciResolve/configs/Fairlight/Effects/FXConfiguration.xml}
# Plugins (Pfad und <FileTime>), deren Maske gesetzt wurde: Änderungen in Resolve bleiben dann
# stehen, bis Resolve das Plugin neu scannt (neue FileTime).
categorized=${XDG_STATE_HOME:-$HOME/.local/state}/resolve-vst/categorized
resolve_categories=('' Channel Delay Dynamics EQ Harmonic Spatial Instrument Mastering Metering
    'Multi Effect' Modulation Restoration Pitch Reverb Surround Tools Other Decoder Vocals Bass
    Guitar Drums Distortion Analysis Monitor Ambisonics - 'Chain FX')

mask_of() { # VST3-Unterkategorien
    local s=$1 i mask=0
    s=${s//Analyzer/Metering} s=${s//Effects/Multi Effect} s=${s//Filter/EQ}
    s=${s//Generator/Tools} s=${s//Sound Field/Surround} s=${s//Up-Downmix/Surround}
    for ((i = 1; i < ${#resolve_categories[@]}; i++)); do
        [[ ${resolve_categories[i]} != - && $s == *"${resolve_categories[i]}"* ]] && mask=$((mask | 1 << i))
    done
    echo "$mask"
}

categories() {
    [[ -f $fx_config && -f $links/.entries ]] || return 0
    local path source id sub mask map
    map=$(while IFS=$'\t' read -r path source id sub; do
        [[ -n $id ]] || continue
        mask=$(mask_of "$sub")
        if ((mask)); then printf '%s/%s\t%s\n' "$links" "$path" "$mask"; fi
    done <"$links/.entries")
    mkdir -p "$(dirname "$categorized")"
    touch "$categorized"
    local tmp=$fx_config.resolve-vst.tmp n
    # VST2-Kategorie (effGetPlugCategory) → Bit: Synth → Instrument, Analysis → Metering,
    # Mastering, Spacializer → Spatial, RoomFx → Reverb, SurroundFx → Surround, Restoration,
    # Generator → Tools.
    awk -v links="$links/" -v done_file="$categorized" -v map="$map" '
        function unxml(s) { gsub(/&lt;/, "<", s); gsub(/&gt;/, ">", s); gsub(/&apos;/, "\047", s);
                            gsub(/&quot;/, "\"", s); gsub(/&amp;/, "\\&", s); return s }
        BEGIN {
            n = split(map, lines, "\n")
            for (i = 1; i <= n; i++) { split(lines[i], f, "\t"); if (f[1] != "") m[f[1]] = f[2] }
            while ((getline line < done_file) > 0) done[line] = 1
            split("2:128 3:512 4:256 5:64 6:16384 7:32768 8:4096 11:65536", v, " ")
            for (i in v) { split(v[i], f, ":"); vst2[f[1]] = f[2] }
        }
        /<Path>/ { p = $0; sub(/.*<Path>/, "", p); sub(/<\/Path>.*/, "", p); path = unxml(p); cat = ""; key = path }
        /<FileTime>/ { t = $0; sub(/.*<FileTime>/, "", t); sub(/<\/FileTime>.*/, "", t); key = path "\t" t }
        /<Category>/ { c = $0; gsub(/[^0-9]/, "", c); cat = c }
        /<CategoryMask>0<\/CategoryMask>/ && index(path, links) == 1 && !(key in done) {
            mask = (path in m) ? m[path] : (cat in vst2 ? vst2[cat] : 0)
            if (mask) { sub(/<CategoryMask>0</, "<CategoryMask>" mask "<"); print key >> done_file; changed++ }
        }
        { print }
        END { print changed + 0 > "/dev/stderr" }
    ' "$fx_config" >"$tmp" 2>"$tmp.n" || { rm -f "$tmp" "$tmp.n"; return 0; }
    n=$(<"$tmp.n")
    rm -f "$tmp.n"
    if ((n > 0)); then
        [[ -f $fx_config.resolve-vst.bak ]] || cp -p "$fx_config" "$fx_config.resolve-vst.bak"
        mv "$tmp" "$fx_config"
        echo "resolve-vst: Kategorien für $n Plugins gesetzt" >&2
    else
        rm -f "$tmp"
    fi
}

# Setzt die Wine-DPI der Prefixe zurück, die der Lader während Resolve geändert hat.
# Zeilen, die nicht zurückgesetzt werden konnten, bleiben für den nächsten Lauf stehen.
restore_wine_dpi() {
    [[ -s $restore ]] || { rm -f "$restore"; return 0; }
    local prefix dpi args keep="" key='HKCU\Control Panel\Desktop'
    local wine=${WINELOADER:-wine}
    while IFS=$'\t' read -r prefix dpi; do
        [[ -n $prefix && -d $prefix ]] || continue
        if [[ $dpi == -1 ]]; then
            args=(reg delete "$key" /v LogPixels /f)
        else
            args=(reg add "$key" /v LogPixels /t REG_DWORD /d "$dpi" /f)
        fi
        if WINEPREFIX=$prefix WINEDEBUG=-all "$wine" "${args[@]}" >/dev/null 2>&1; then
            echo "resolve-vst: Wine-DPI in $prefix wieder ${dpi/#-1/Standard}" >&2
        else
            echo "resolve-vst: Wine-DPI in $prefix nicht zurückgesetzt" >&2
            keep+="$prefix"$'\t'"$dpi"$'\n'
        fi
    done <"$restore"
    if [[ -n $keep ]]; then printf '%s' "$keep" >"$restore"; else rm -f "$restore"; fi
}

case ${1:-} in
link)
    link
    ;;
list)
    plugins | cut -f2
    if [[ -n $classes ]]; then
        bundles | cut -f2 | while IFS= read -r bundle; do
            classes_of "$bundle" | while IFS=$'\t' read -r id name sub; do
                printf '%s\t%s\t%s\n' "$bundle" "$name" "$sub"
            done
        done
    fi
    ;;
restore)
    restore_wine_dpi
    ;;
categories)
    categories
    ;;
*)
    [[ -n $lib ]] || { echo "resolve-vst: libresolve-vst.so nicht gefunden (make?)" >&2; exit 1; }
    link
    categories
    # Wie im eigenen DaVinciResolve.desktop: Resolves Qt 5 skaliert sonst nicht nach der
    # Bildschirm-DPI (Xft.dpi), die Oberfläche wird winzig. Gesetzte Werte haben Vorrang.
    export QT_AUTO_SCREEN_SCALE_FACTOR=${QT_AUTO_SCREEN_SCALE_FACTOR:-1}
    export QT_SCALE_FACTOR=${QT_SCALE_FACTOR:-1.0}
    # Reste eines abgebrochenen Laufs zuerst, sonst merkt sich der Lader den geänderten
    # Wert als Vorwert.
    restore_wine_dpi
    # Kein exec: Nach dem Ende von Resolve (auch nach einem Absturz) die Wine-DPI
    # zurücksetzen. LD_PRELOAD nur für Resolve, nicht für die Wine-Aufrufe hier.
    status=0
    LD_PRELOAD="$lib${LD_PRELOAD:+:$LD_PRELOAD}" "$resolve" "$@" || status=$?
    # Nach einem Absturz hängen yabridge-Plugingruppen (z. B. Waves) beim nächsten Editor bis
    # zu zwei Minuten, weil sie den verschwundenen Host noch bedienen: beenden.
    if ((status >= 128)) && pkill -f 'yabridge-host\.exe\.so group '; then
        echo "resolve-vst: Resolve abgestürzt, yabridge-Plugingruppen beendet" >&2
    fi
    restore_wine_dpi
    exit "$status"
    ;;
esac
